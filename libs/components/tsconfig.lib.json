{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "lib": ["dom"],
    "types": [
      "node",
      "nativewind/types",
      "@nx/react/typings/cssmodule.d.ts",
      "@nx/react/typings/image.d.ts"
    ],
    "rootDir": "src",
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo"
  },
  "exclude": [
    "out-tsc",
    "dist",
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx",
    "src/**/*.spec.js",
    "src/**/*.test.js",
    "src/**/*.spec.jsx",
    "src/**/*.test.jsx",
    "src/**/__mocks__/**",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "../ui-navigation/tsconfig.lib.json"
    },
    {
      "path": "../assets/tsconfig.lib.json"
    },
    {
      "path": "../design-tokens/tsconfig.lib.json"
    },
    {
      "path": "../ui-state/tsconfig.lib.json"
    },
    {
      "path": "../ui-logic/tsconfig.lib.json"
    },
    {
      "path": "../ui-api-interaction/tsconfig.lib.json"
    },
    {
      "path": "../language/tsconfig.lib.json"
    },
    {
      "path": "../controls-basic/tsconfig.lib.json"
    },
    {
      "path": "../controls/tsconfig.lib.json"
    },
    {
      "path": "../api-controller/tsconfig.lib.json"
    }
  ]
}
